{
  "manifest_version": 3,
  "name": "NINA",
  "description": "Networked Inventory Navigation Assistant — a minimal Firefox extension shell.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "nina-dev@example.invalid"
    }
  },
  "icons": {
    "48": "assets/icons/nina.svg"
  },
  "action": {
    "default_title": "NINA",
    "default_popup": "src/popup/popup.html",
    "default_icon": "assets/icons/nina.svg",
    "default_area": "navbar"
  },
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.it/*"],
      "js": ["src/content/content.js"]
    }
  ]
}
